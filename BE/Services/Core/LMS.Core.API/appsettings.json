{
    "Database": {
        "Provider": "Sqlite",
        "AutoMigrate": false
    },
    "ConnectionStrings": {
        "LmsDb": "",
        "Sqlite": "Data Source=lms-ai.sqlite"
    },
    "Jwt": {
        "Issuer": "LMS-AI",
        "Audience": "LMS-AI-Frontend"
    },
    "Demo": {
        "Seed": false
    },
    "Storage": {
        "RootPath": "Uploads",
        "MaxUploadBytes": 5000000,
        "MaxExtractedCharacters": 2000000,
        "MaxArchiveExpandedBytes": 50000000,
        "MaxArchiveEntries": 2000,
        "MaxPdfPages": 500,
        "MaxPreviewCharacters": 30000
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Ai": {
        "Mode": "Gemini",
        "GeminiModel": "gemini-3.8-flash",
        "TimeoutSeconds": 45,
        "MaxSourceCharacters": 16000,
        "MaxGenerationChunks": 3,
        "MaxProviderRequests": 4,
        "MaxRetries": 1,
        "RetryBaseDelaySeconds": 2,
        "MaxRetryDelaySeconds": 30,
        "GenerationTimeoutSeconds": 240
    }
}
