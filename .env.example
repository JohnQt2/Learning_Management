# Backend reads this file from repository root (or next to appsettings.json when published).
# Process environment and CLI override these values. Never commit .env.
Database__Provider=Sqlite
Database__AutoMigrate=true
ConnectionStrings__Sqlite=Data Source=lms-ai.sqlite
Storage__RootPath=Uploads
Demo__Seed=false
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
Ai__Mode=Disabled
Ai__GeminiModel=gemini-3.5-flash-lite
Ai__TimeoutSeconds=45
Ai__MaxSourceCharacters=16000
# Each generation covers every source character or is rejected before any provider request.
Ai__MaxGenerationChunks=3
Ai__MaxProviderRequests=4
# Only upstream 429/503 may retry; all chunks and retries share the request budget.
Ai__MaxRetries=1
Ai__RetryBaseDelaySeconds=2
Ai__MaxRetryDelaySeconds=30
Ai__GenerationTimeoutSeconds=240
# Set a private Gemini key, then change Ai__Mode to Gemini and restart Backend.
Ai__GeminiApiKey=
# Local .env gets a generated signing key. For your own deployment set a random key >=32 bytes.
# Jwt__Key=
# Production: AutoMigrate=false, explicit HTTPS CORS, persistent storage and no demo seed.
# ASPNETCORE_ENVIRONMENT must be set outside .env or through launch profile.
